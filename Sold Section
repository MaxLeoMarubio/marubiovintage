<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Marubio Vintage — Curated Vintage Clothing</title>
<meta name="description" content="Marubio Vintage — hand-picked vintage clothing. Curated, one-of-a-kind pieces." />
<style>
  :root{
    --ink:#111111;
    --paper:#ffffff;
    --muted:#6b6b6b;
    --line:#e6e6e6;
    --soft:#f5f5f4;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;
    color:var(--ink);
    background:var(--paper);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1100px;margin:0 auto;padding:0 24px}

  /* Header */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,.9);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .bar{display:flex;align-items:center;justify-content:space-between;height:68px}
  .brand{font-weight:700;letter-spacing:.22em;font-size:15px;text-transform:uppercase}
  nav a{margin-left:26px;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  nav a:hover{color:var(--ink)}
  .nav-shop{color:var(--ink)!important;font-weight:600}
  .menu{display:flex;align-items:center}

  /* Hero */
  .hero{padding:120px 0 90px;text-align:center;border-bottom:1px solid var(--line)}
  .hero .eyebrow{font-size:12px;letter-spacing:.35em;text-transform:uppercase;color:var(--muted);margin-bottom:22px}
  .hero h1{font-size:clamp(38px,7vw,74px);line-height:1.02;font-weight:700;letter-spacing:-.02em}
  .hero p{max-width:560px;margin:22px auto 0;color:var(--muted);font-size:17px}
  .btn{
    display:inline-block;margin-top:34px;
    background:var(--ink);color:var(--paper);
    padding:15px 40px;font-size:13px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;
    border:1px solid var(--ink);transition:.15s;
  }
  .btn:hover{background:var(--paper);color:var(--ink)}
  .btn-outline{background:transparent;color:var(--ink)}
  .btn-outline:hover{background:var(--ink);color:var(--paper)}

  /* Section heads */
  .sec{padding:84px 0}
  .sec-head{text-align:center;margin-bottom:46px}
  .sec-head .eyebrow{font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
  .sec-head h2{font-size:clamp(26px,4vw,38px);font-weight:700;letter-spacing:-.01em}

  /* Collection grid */
  .grid{display:flex;flex-wrap:wrap;justify-content:center;gap:20px}
  .card{
    width:300px;max-width:100%;
    background:var(--paper);border:1px solid var(--line);overflow:hidden;
    display:block;transition:.15s;
  }
  .card:hover{transform:translateY(-4px);box-shadow:0 12px 30px rgba(0,0,0,.08)}
  .card img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;background:var(--soft)}
  .card .cap{padding:14px 16px}
  .card .cap .title{font-size:14px;letter-spacing:.02em;line-height:1.35}
  .card .cap .price{margin-top:6px;font-size:13px;letter-spacing:.06em;color:var(--muted);text-transform:uppercase}
  .empty{text-align:center;color:var(--muted);padding:20px}

  /* About */
  .about{background:var(--ink);color:var(--paper)}
  .about .wrap{padding:90px 24px;max-width:760px;text-align:center}
  .about .eyebrow{color:#9a9a9a;font-size:12px;letter-spacing:.3em;text-transform:uppercase;margin-bottom:18px}
  .about h2{font-size:clamp(24px,4vw,34px);font-weight:700;margin-bottom:20px}
  .about p{color:#cfcfcf;font-size:17px}

  /* CTA */
  .cta{text-align:center;padding:96px 0;border-bottom:1px solid var(--line)}
  .cta h2{font-size:clamp(28px,5vw,46px);font-weight:700;letter-spacing:-.02em}
  .cta p{color:var(--muted);margin-top:16px}

  /* Footer */
  footer{padding:50px 0;text-align:center;color:var(--muted);font-size:13px}
  footer .links{margin-bottom:16px}
  footer .links a{margin:0 14px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink)}
  footer .links a:hover{color:var(--muted)}

  @media(max-width:720px){
    nav .hide-sm{display:none}
    .grid{grid-template-columns:repeat(2,1fr)}
    .hero{padding:80px 0 64px}
  }

  /* Sold */
  .sold-sec{background:var(--soft);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .sold-sec .sec-head p{max-width:520px;margin:14px auto 0;color:var(--muted);font-size:15px}
  .card.sold{cursor:default}
  .card.sold:hover{transform:none;box-shadow:none}
  .card.sold .photo{position:relative}
  .card.sold img{filter:grayscale(.35) brightness(.96)}
  .card.sold .badge{
    position:absolute;top:12px;left:12px;
    background:var(--ink);color:var(--paper);
    font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;
    padding:6px 12px;
  }
  .card.sold .cap .detail{margin-top:6px;font-size:13px;color:var(--muted);line-height:1.45}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <div class="brand">Marubio Vintage</div>
    <nav class="menu">
      <a href="#collection" class="hide-sm">Collection</a>
      <a href="#sold" class="hide-sm">Sold</a>
      <a href="#about" class="hide-sm">About</a>
      <a href="#" class="nav-shop" data-shop>Shop</a>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <div class="eyebrow">Curated Vintage Clothing</div>
    <h1>Timeless pieces,<br />chosen with care.</h1>
    <p>Hand-picked vintage clothing — one-of-a-kind finds you won't see on anyone else. New drops added often.</p>
    <a href="#" class="btn" data-shop>Shop the Collection</a>
  </div>
</section>

<section class="sec" id="collection">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">Latest Finds</div>
      <h2>The Collection</h2>
    </div>
    <div class="grid" id="grid"></div>
    <div style="text-align:center;margin-top:44px">
      <a href="#" class="btn btn-outline" data-shop>Browse the full shop →</a>
    </div>
  </div>
</section>

<section class="sec sold-sec" id="sold">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">Past Finds</div>
      <h2>Sold</h2>
      <p>One-of-a-kind pieces that have found a new home.</p>
    </div>
    <div class="grid" id="sold-grid"></div>
  </div>
</section>

<section class="about" id="about">
  <div class="wrap">
    <div class="eyebrow">About</div>
    <h2>Vintage, done right.</h2>
    <p>Marubio Vintage is a small, independent shop built on a love for well-made clothing with a story. Every piece is hand-selected for quality, character, and that one-of-a-kind feel — cleaned, checked, and ready for its next chapter.</p>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2>Find your next favorite.</h2>
    <p>Every piece is unique — when it's gone, it's gone.</p>
    <a href="#" class="btn" data-shop>Shop Now</a>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="links">
      <a href="#" data-shop>Shop</a>
      <a href="#collection">Collection</a>
      <a href="#sold">Sold</a>
      <a href="#about">About</a>
    </div>
    <div>© <span id="yr"></span> Marubio Vintage. All rights reserved.</div>
  </div>
</footer>

<script>
  // ---- YOUR SHOP LINK ----
  var SHOP_LINK = "https://www.depop.com/mmarubio";

  // ---- YOUR LISTINGS ----
  // Pulled from your Depop shop. To refresh, just ask and I'll update this list.
  var PRODUCTS = [
    {
      title: "Selvedge Denim — Stronghold, Dark Wash",
      price: "$30.00",
      slug: "mmarubso-selvedge-denim-stronghold-dark-wash-9303",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "Fleece-Lined Carhartt Jacket — Black",
      price: "$15.00",
      slug: "mmarudio-fleece-lined-carhartt-black-and-4a52",
      image: "data:image/jpeg;base64,"
    }
  ];


  // ---- SOLD ITEMS ----
  // Past sales, details copied from the Depop listings.
  var SOLD = [
    {
      title: "Y2K Carhartt Blue Denim Jeans",
      detail: "Size 36x36",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "Navy Acne Studios Hoodie",
      detail: "White logo on back. Oversized, relaxed fit.",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "Portugal 2006 World Cup Nike Jersey",
      detail: "Says large, fits medium.",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "Navy & Green Polo Ralph Lauren Polo Shirt",
      detail: "",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "1992 Chicago Bulls 10th Anniversary Champions Hat",
      detail: "Black hat with embroidered logo.",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "Argentina National Team Adidas Long Sleeve Training Top",
      detail: "",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "2006 Germany World Cup Tee",
      detail: "",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "AC Milan Track Jacket",
      detail: "Black and red.",
      image: "data:image/jpeg;base64,"
    },
    {
      title: "Regular Ralf Nudie Jeans",
      detail: "Says 31/32, fits 32/36. Clean fades.",
      image: "data:image/jpeg;base64,"
    }
  ];

  // Render the shop links
  document.querySelectorAll("[data-shop]").forEach(function(a){
    if(SHOP_LINK && SHOP_LINK !== "#"){ a.setAttribute("href", SHOP_LINK); a.setAttribute("target","_blank"); a.setAttribute("rel","noopener"); }
  });

  // Render the product grid
  var grid = document.getElementById("grid");
  if(PRODUCTS.length === 0){
    grid.innerHTML = '<div class="empty">New pieces coming soon — check the shop.</div>';
  } else {
    PRODUCTS.forEach(function(p){
      var url = "https://www.depop.com/products/" + p.slug + "/";
      var a = document.createElement("a");
      a.className = "card";
      a.href = url; a.target = "_blank"; a.rel = "noopener";
      a.innerHTML =
        '<img src="' + p.image + '" alt="' + p.title.replace(/"/g,'&quot;') + '" loading="lazy" />' +
        '<div class="cap"><div class="title">' + p.title + '</div>' +
        '<div class="price">' + p.price + '</div></div>';
      grid.appendChild(a);
    });
  }


  // Render the sold grid
  var soldGrid = document.getElementById("sold-grid");
  if(soldGrid){
    SOLD.forEach(function(p){
      var d = document.createElement("div");
      d.className = "card sold";
      d.innerHTML =
        '<div class="photo"><img src="' + p.image + '" alt="' + p.title.replace(/"/g,'&quot;') + ' (sold)" loading="lazy" />' +
        '<span class="badge">Sold</span></div>' +
        '<div class="cap"><div class="title">' + p.title + '</div>' +
        (p.detail ? '<div class="detail">' + p.detail + '</div>' : '') + '</div>';
      soldGrid.appendChild(d);
    });
  }

  document.getElementById("yr").textContent = new Date().getFullYear();
</script>

</body>
</html>
